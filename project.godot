config_version=5
[application]
config/name="Lake City"
run/main_scene="res://city.tscn"
[display]
window/size/viewport_width=1024
window/size/viewport_height=640
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12,0.19,0.28,1)
