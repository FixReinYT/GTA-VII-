static func read_chapter() -> int:
	var cfg := ConfigFile.new()
	if cfg.load(SAVE) != OK:
		return 0
	return clampi(int(cfg.get_value("story","chapter",0)),0,NAMES.size())

static func save_chapter(chapter: int):
	var cfg := ConfigFile.new()
	cfg.set_value("story","chapter",chapter)
	cfg.save(SAVE)
